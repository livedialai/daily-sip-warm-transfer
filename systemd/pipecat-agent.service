[Unit]
Description=Pipecat voice agent (Daily room, warm transfer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/pipecat-agent
EnvironmentFile=/opt/pipecat-agent/.env
ExecStart=/opt/pipecat-agent/venv/bin/python bot.py
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
