# --- Daily room ---
DAILY_ROOM_URL=https://your-domain.daily.co/your-room
DAILY_API_KEY=
# meeting token with {"properties": {"is_owner": true}} — required for REST dialOut
DAILY_TOKEN=

# --- transfer target: the human the caller is transferred to ---
CHEF_SIP=sip:+1555*******@carrier.example
TRANSFER_TIMEOUT_S=45

# --- STT: speechmatics (default) or deepgram ---
STT_PROVIDER=speechmatics
SPEECHMATICS_API_KEY=
SPEECHMATICS_MODEL=linden-1
DEEPGRAM_API_KEY=
STT_LANGUAGE=de
DEEPGRAM_MODEL=nova-3

# --- turn detection (energy VAD in front of the STT) ---
# minimum peak amplitude to count as speech; 0 = adaptive (2.5x noise floor)
VAD_RMS=0
# silence that closes the user's turn
VAD_HANGOVER_MS=900

# --- LLM (any OpenAI-compatible endpoint) ---
LLM_BASE=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- TTS ---
INWORLD_API_KEY=
INWORLD_VOICE=

# --- wording ---
BOT_NAME=Phone assistant
OPENER_TEXT=Hello, how can I help you?
HOLD_TEXT=One moment please, I am connecting you.
FAIL_TEXT=I could not reach anyone right now. Is there anything else I can do?

# --- hold music ---
# 16 kHz mono s16 loop, played by the second participant (moh_agent.py)
HOLD_MUSIC_WAV16=/opt/pipecat-agent/hold16.wav
HOLD_MUSIC_WAV=/opt/pipecat-agent/hold.wav
# lease file the bot writes: "on"/"off" plus mtime, read by moh_agent.py
MOH_STATE_FILE=/tmp/moh.state
