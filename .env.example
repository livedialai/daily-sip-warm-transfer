# ---- Daily ----
DAILY_ROOM_URL=https://your-domain.daily.co/your-room
DAILY_API_KEY=
# meeting token created with {"properties": {"is_owner": true}}
DAILY_TOKEN=

# ---- transfer target (the human) ----
TRANSFER_TARGET=sip:+15551234567@carrier.example
TRANSFER_TIMEOUT_S=45

# ---- agent providers ----
DEEPGRAM_API_KEY=
INWORLD_API_KEY=
INWORLD_VOICE=
LLM_API_KEY=
LLM_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
STT_MODEL=nova-3
STT_LANGUAGE=en
TTS_MODEL=inworld-tts-2
BOT_NAME=Phone assistant

# ---- wording (keep it in config, not in code) ----
OPENER_TEXT=Hello, how can I help you?
HOLD_TEXT=One moment please, I am connecting you.
FAIL_TEXT=I could not reach anyone right now. Is there anything else I can do?
